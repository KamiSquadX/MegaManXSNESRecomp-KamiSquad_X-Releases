<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Long-press the app icon to pick the ROMs again (e.g. add Mega Man X3). -->
    <shortcut
        android:shortcutId="setup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/setup_short"
        android:shortcutLongLabel="@string/setup_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.kamisquadx.megamanxrecomp"
            android:targetClass="com.kamisquadx.megamanxrecomp.SetupActivity">
            <extra android:name="setup" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
